// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: {userId}
// Fields:
//   - uid: string (required) - Firebase Auth UID
//   - email: string (required) - User email
//   - displayName: string (optional)
//   - createdAt: timestamp (optional)
//
// Collection: routes
// Document ID: {routeId}
// Fields:
//   - uid: string (required) - Owner UID
//   - name: string (required) - Route name
//   - origin: map (required) - {name, lat, lng}
//   - destination: map (required) - {name, lat, lng}
//   - waypoints: list (optional) - Array of {name, lat, lng}
//   - averageSpeed: number (required)
//   - departureTime: number (required) - timestamp
//   - createdAt: number (required) - timestamp
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string &&
             data.email is string;
    }
    
    function isValidRoute(data) {
      return data.keys().hasAll(['uid', 'origin', 'destination', 'averageSpeed', 'departureTime']) &&
             data.uid == request.auth.uid &&
             data.averageSpeed is number &&
             data.averageSpeed > 0 &&
             data.departureTime is number;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
    }

    match /routes/{routeId} {
      allow read: if isDocOwner();
      allow create: if isAuthenticated() && isValidRoute(request.resource.data);
      allow update: if isDocOwner() && isValidRoute(request.resource.data);
      allow delete: if isDocOwner();
    }
  }
}
